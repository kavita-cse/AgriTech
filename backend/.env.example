# AgriTech Backend Environment Variables
# Copy this file to .env and configure your values.
# NEVER commit the actual .env file with real secrets.

# Server Port
PORT=5000

# Application Environment (development, production, test)
NODE_ENV=development

# Allowed Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection URI (replace with real MongoDB Atlas URI or local instance)
# Format: mongodb+srv://<username>:<password>@<cluster-address>/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/agritech?retryWrites=true&w=majority

# JWT Authentication
# Generate a secure 64-character hex string for production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d
